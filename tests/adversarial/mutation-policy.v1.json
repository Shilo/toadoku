      "json",
      "html",
      "event-recorder"
    ],
    "eventReporter": {
      "baseDir": "<artifact-path>"
    },
    "jsonReporter": {
      "fileName": "<artifact-path>"
    },
    "htmlReporter": {
      "fileName": "<artifact-path>"
    },
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "timeoutMS": 10000,
    "timeoutFactor": 2,
    "dryRunTimeoutMinutes": 10,
    "disableBail": false,
    "cleanTempDir": false,
    "incremental": true,
    "incrementalFile": "<artifact-path>",
    "fileLogLevel": "off",
