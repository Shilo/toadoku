{
  "version": 1,
  "note": "AGG001 pinned effective policy. Only canonical output-path leaves and force:true strengthening may vary; mutation scope is independently verified as exact full files.",
  "node": "v25.0.0",
  "packages": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "vitest": "4.1.12",
    "typescript": "6.0.3"
  },
  "configs": {
