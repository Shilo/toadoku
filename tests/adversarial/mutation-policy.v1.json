    "dryRunOnly": false,
    "ignoreStatic": false,
    "force": false,
    "inPlace": false,
    "maxConcurrentTestRunners": 9007199254740991,
    "maxTestRunnerReuse": 0,
    "mutator": {
      "plugins": null,
      "excludedMutations": []
    },
    "appendPlugins": [],
    "disableTypeChecks": true,
    "testRunnerNodeArgs": [],
    "tsconfigFile": "tsconfig.json",
    "warnings": true,
    "allowEmpty": false,
    "ignorers": [],
    "testFiles": []
