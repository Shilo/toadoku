{
  "name": "toadodu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node tools/test.mjs unit",
    "test:browser": "node tools/test.mjs browser",
    "test:browser:install": "node tools/test.mjs install",
    "test:browsers:install": "node tools/test.mjs install firefox webkit",
    "test:storage": "node tools/test.mjs browser --config tests/storage/playwright.config.ts",
    "test:models": "node tools/test.mjs unit tests/session/model.test.ts",
    "test:coverage": "node tools/test.mjs unit --config tests/adversarial/vitest.coverage.config.ts",
    "test:mutation": "stryker run tests/adversarial/stryker.config.mjs",
    "test:mutation:review": "node tests/adversarial/mutation-jobs.mjs review",
    "test:mutation:capture": "node tests/adversarial/mutation-jobs.mjs capture",
    "catalog:capture": "node tools/catalog/source.ts",
    "catalog:build": "node tools/catalog/import.ts",
    "catalog:verify": "node tools/catalog/verify.ts public/catalog/v1",
    "catalog:checkouts": "node tools/catalog/checkouts.ts"
  },
  "dependencies": {
    "@lucide/svelte": "1.66.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/mcp": "0.1.28",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "25.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
